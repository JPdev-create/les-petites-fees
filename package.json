{
  "name": "les-petites-fees",
  "version": "1.0.0",
  "private": true,
  "description": "Les Petites Fées — planning des nettoyages de gîtes et bureaux (PWA, Firebase, GitHub Pages)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npx serve out -l 4000",
    "emulators": "firebase emulators:start --project demo-lpf --only auth,firestore",
    "seed": "tsx scripts/seed.ts",
    "automation": "tsx scripts/automation.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "import:chantiers": "tsx scripts/import-chantiers.ts",
    "check:recurrences": "tsx scripts/check-recurrences.ts",
    "deploy:rules": "firebase deploy --only firestore",
    "typecheck": "tsc --noEmit",
    "guide:pdf": "next build && node scripts/guide-pdf.mjs"
  },
  "dependencies": {
    "firebase": "^12.3.0",
    "geist": "1.5.1",
    "lucide-react": "0.544.0",
    "next": "~15.5",
    "nodemailer": "7.0.6",
    "react": "~19.1",
    "react-dom": "~19.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/nodemailer": "7.0.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^14.17.0",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
