# Variables utilisées par les scripts d'automatisation (GitHub Actions → Secrets)
# Contenu JSON complet de la clé de compte de service Firebase (NE JAMAIS COMMITER)
FIREBASE_SERVICE_ACCOUNT=
# URL publique du site (liens dans les e-mails)
APP_URL=https://<pseudo>.github.io/planning
# Gmail de l'entreprise + mot de passe d'application (validation en 2 étapes requise)
SMTP_USER=petitesfeesdemarche@gmail.com
SMTP_PASS=
# SMS via Twilio (optionnel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
